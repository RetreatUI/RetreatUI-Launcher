<Window x:Class="RetreatUI.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RetreatUI Launcher"
        Width="1060"
        Height="820"
        MinWidth="940"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/RetreatUI_Launcher.ico">
    <Window.Resources>
        <Style x:Key="EditionRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="EditionCard"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter VerticalAlignment="Center"/>
                                <Border x:Name="SelectionMark"
                                        Grid.Column="1"
                                        Width="13"
                                        Height="13"
                                        Margin="18,0,0,0"
                                        CornerRadius="7"
                                        Background="Transparent"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="2"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="EditionCard" Property="Background" Value="#241F18"/>
                                <Setter TargetName="EditionCard" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="SelectionMark" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="SelectionMark" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="EditionCard" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="EditionCard" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VersionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelAltBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
    </Window.Resources>

    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="22"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="Assets/RetreatUI_Launcher_256.png"
                       Width="58"
                       Height="58"
                       Stretch="Uniform"
                       Margin="0,0,16,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="RETREATUI LAUNCHER"
                               FontSize="25"
                               FontWeight="Bold"/>
                    <TextBlock x:Name="LauncherVersionText"
                               Text="Launcher"
                               Margin="1,4,0,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="12"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                <TextBlock Text="UPDATE CHANNEL"
                           HorizontalAlignment="Right"
                           Margin="0,0,0,7"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="11"
                           FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="StableRadio"
                                 GroupName="Channel"
                                 Content="Stable"
                                 Style="{StaticResource ChannelRadioStyle}"
                                 Checked="ChannelRadio_Checked"/>
                    <RadioButton x:Name="BetaRadio"
                                 GroupName="Channel"
                                 Content="Beta"
                                 Margin="8,0,0,0"
                                 Style="{StaticResource ChannelRadioStyle}"
                                 Checked="ChannelRadio_Checked"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="CHOOSE YOUR GAME"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="11"
                       FontWeight="SemiBold"/>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <RadioButton x:Name="CoARadio"
                             GroupName="Edition"
                             Style="{StaticResource EditionRadioStyle}"
                             Checked="EditionRadio_Checked">
                    <StackPanel>
                        <TextBlock Text="CONQUEST OF AZEROTH"
                                   FontSize="18"
                                   FontWeight="Bold"/>
                        <TextBlock Text="Project Ascension · 21 custom classes"
                                   Margin="0,6,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="13"/>
                        <TextBlock Text="CoA"
                                   Margin="0,12,0,0"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="TbcRadio"
                             Grid.Column="2"
                             GroupName="Edition"
                             Style="{StaticResource EditionRadioStyle}"
                             Checked="EditionRadio_Checked">
                    <StackPanel>
                        <TextBlock Text="THE BURNING CRUSADE"
                                   FontSize="18"
                                   FontWeight="Bold"/>
                        <TextBlock Text="Classic / Anniversary client"
                                   Margin="0,6,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="13"/>
                        <TextBlock Text="TBC"
                                   Margin="0,12,0,0"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </RadioButton>
            </Grid>
        </Grid>

        <Border Grid.Row="4"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="9"
                Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="EditionTitleText"
                                   Text="Conquest of Azeroth"
                                   FontSize="20"
                                   FontWeight="Bold"/>
                        <TextBlock x:Name="EditionSubtitleText"
                                   Text="Project Ascension installation"
                                   Margin="0,4,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"/>
                    </StackPanel>
                    <Button x:Name="LauncherUpdateButton"
                            Grid.Column="1"
                            Content="UPDATE LAUNCHER"
                            Margin="14,0,0,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Visibility="Collapsed"
                            Click="LauncherUpdateButton_Click"/>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource VersionCardStyle}">
                        <StackPanel>
                            <TextBlock Text="INSTALLED"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>
                            <TextBlock x:Name="InstalledVersionText"
                                       Text="Unknown"
                                       Margin="0,7,0,0"
                                       FontSize="23"
                                       FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource VersionCardStyle}">
                        <StackPanel>
                            <TextBlock Text="LATEST ON CHANNEL"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>
                            <TextBlock x:Name="LatestVersionText"
                                       Text="Checking..."
                                       Margin="0,7,0,0"
                                       FontSize="23"
                                       FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="{StaticResource PanelAltBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="14,11">
                        <StackPanel>
                            <TextBlock x:Name="PathLabelText"
                                       Text="PROJECT ASCENSION ADDONS FOLDER"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="10.5"
                                       FontWeight="SemiBold"/>
                            <TextBlock x:Name="PathText"
                                       Text="Not selected"
                                       Margin="0,5,0,0"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        </StackPanel>
                    </Border>
                    <Button Grid.Column="2"
                            Content="Choose Folder"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="ChooseFolderButton_Click"/>
                </Grid>

                <Grid Grid.Row="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <Button x:Name="UpdateButton"
                                Content="CHECKING..."
                                Style="{StaticResource PrimaryButtonStyle}"
                                IsEnabled="False"
                                Click="UpdateButton_Click"/>
                        <ProgressBar x:Name="DownloadProgress"
                                     Height="5"
                                     Margin="0,8,0,0"
                                     Minimum="0"
                                     Maximum="100"
                                     Visibility="Collapsed"/>
                    </StackPanel>
                    <Button x:Name="RefreshButton"
                            Grid.Column="2"
                            Content="Refresh"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="RefreshButton_Click"/>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="6"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="9"
                Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="ReleaseHeadingText"
                           Text="LATEST COA CHANGES"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource MutedTextBrush}"/>
                <TextBox x:Name="ReleaseNotesText"
                         Grid.Row="2"
                         Text="Checking GitHub releases..."
                         IsReadOnly="True"
                         BorderThickness="0"
                         Padding="0"
                         Background="Transparent"
                         Foreground="{StaticResource TextBrush}"
                         CaretBrush="{StaticResource TextBrush}"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         FontFamily="Segoe UI"
                         FontSize="13.5"/>
            </Grid>
        </Border>

        <Grid Grid.Row="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse x:Name="StatusDot"
                         Width="9"
                         Height="9"
                         Fill="{StaticResource MutedTextBrush}"
                         Margin="0,0,8,0"/>
                <TextBlock x:Name="StatusText"
                           Text="Starting launcher..."
                           Foreground="{StaticResource MutedTextBrush}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <Button x:Name="SupportButton"
                    Grid.Column="1"
                    Content="Support RetreatUI"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="SupportButton_Click"/>
            <Button x:Name="OpenFolderButton"
                    Grid.Column="3"
                    Content="Open AddOns Folder"
                    Style="{StaticResource SecondaryButtonStyle}"
                    IsEnabled="False"
                    Click="OpenFolderButton_Click"/>
            <Button x:Name="LaunchButton"
                    Grid.Column="5"
                    Content="Launch CoA"
                    Style="{StaticResource SecondaryButtonStyle}"
                    IsEnabled="False"
                    Click="LaunchButton_Click"/>
        </Grid>
    </Grid>
</Window>
