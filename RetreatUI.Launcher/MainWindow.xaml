<Window x:Class="RetreatUI.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RetreatUI Launcher"
        Width="1080"
        Height="840"
        MinWidth="960"
        MinHeight="740"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Icon="Assets/RetreatUI_Launcher.ico">
    <Window.Resources>
        <Style x:Key="EditionRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="#D10D141C"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="146"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="EditionCard"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Stretch"/>
                                <Border x:Name="SelectionMark"
                                        Grid.Column="1"
                                        Width="15"
                                        Height="15"
                                        Margin="18,0,0,0"
                                        CornerRadius="8"
                                        Background="Transparent"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="2"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="EditionCard" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="EditionCard" Property="BorderThickness" Value="1.5"/>
                                <Setter TargetName="EditionCard" Property="Background" Value="#E4161D28"/>
                                <Setter TargetName="SelectionMark" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="SelectionMark" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="EditionCard" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="EditionCard" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VersionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#D81A2330"/>
            <Setter Property="BorderBrush" Value="{StaticResource SoftBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style x:Key="DetailWatermarkStyle" TargetType="Image">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Opacity" Value="0.24"/>
            <Setter Property="Margin" Value="0,16,28,0"/>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource LauncherBackgroundBrush}" ClipToBounds="True">
        <Rectangle Fill="{StaticResource HeaderGlowBrush}" IsHitTestVisible="False"/>
        <Ellipse Width="520"
                 Height="520"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top"
                 Margin="-140,-120,0,0"
                 IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush RadiusX="0.65" RadiusY="0.65">
                    <GradientStop Color="#1A4388FF" Offset="0"/>
                    <GradientStop Color="#003A88FF" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Ellipse Width="440"
                 Height="440"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Top"
                 Margin="0,-60,-100,0"
                 IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush RadiusX="0.68" RadiusY="0.68">
                    <GradientStop Color="#1645D86F" Offset="0"/>
                    <GradientStop Color="#0045D86F" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Ellipse Width="360"
                 Height="360"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Bottom"
                 Margin="0,0,-110,-100"
                 IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush RadiusX="0.68" RadiusY="0.68">
                    <GradientStop Color="#18D89A3E" Offset="0"/>
                    <GradientStop Color="#00D89A3E" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="58"
                            Height="58"
                            CornerRadius="10"
                            BorderBrush="#895C2D1A"
                            BorderThickness="1"
                            Background="#D20A0E13"
                            Margin="0,0,14,0">
                        <Image Source="Assets/RetreatUI_Launcher_256.png"
                               Width="54"
                               Height="54"
                               Stretch="Uniform"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="RETREATUI LAUNCHER"
                                   Foreground="White"
                                   FontFamily="Georgia"
                                   FontSize="26"
                                   FontWeight="Bold"/>
                        <TextBlock x:Name="LauncherVersionText"
                                   Text="Launcher"
                                   Margin="1,4,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="12"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock Text="UPDATE CHANNEL"
                               HorizontalAlignment="Right"
                               Margin="0,0,0,7"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="11"
                               FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="StableRadio"
                                     GroupName="Channel"
                                     Content="Stable"
                                     Style="{StaticResource ChannelRadioStyle}"
                                     Checked="ChannelRadio_Checked"/>
                        <RadioButton x:Name="BetaRadio"
                                     GroupName="Channel"
                                     Content="Beta"
                                     Margin="8,0,0,0"
                                     Style="{StaticResource ChannelRadioStyle}"
                                     Checked="ChannelRadio_Checked"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="CHOOSE YOUR GAME"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="11"
                           FontWeight="SemiBold"/>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <RadioButton x:Name="CoARadio"
                                 GroupName="Edition"
                                 Style="{StaticResource EditionRadioStyle}"
                                 Background="#D1111924"
                                 Checked="EditionRadio_Checked">
                        <Grid ClipToBounds="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="0.95*"/>
                            </Grid.ColumnDefinitions>
                            <Rectangle Grid.ColumnSpan="2"
                                       RadiusX="10"
                                       RadiusY="10"
                                       Fill="{StaticResource CardFadeBrush}"
                                       IsHitTestVisible="False"/>
                            <StackPanel VerticalAlignment="Center" Margin="0,2,0,0">
                                <Border HorizontalAlignment="Left"
                                        Background="#2A2F7DFF"
                                        BorderBrush="#4467A9FF"
                                        BorderThickness="1"
                                        CornerRadius="999"
                                        Padding="10,4">
                                    <TextBlock Text="PROJECT ASCENSION"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="#DCE7FF"/>
                                </Border>
                                <TextBlock Text="CONQUEST OF AZEROTH"
                                           Margin="0,12,0,0"
                                           FontFamily="Georgia"
                                           FontSize="18"
                                           FontWeight="Bold"/>
                                <TextBlock Text="Project Ascension · 21 custom classes"
                                           Margin="0,7,0,0"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="13"/>
                                <TextBlock Text="All class content and launcher paths stay separated from TBC."
                                           Margin="0,8,0,0"
                                           Foreground="#B8C8D9"
                                           FontSize="11.5"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="CoA"
                                           Margin="0,12,0,0"
                                           Foreground="#7EB3FF"
                                           FontSize="11"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                            <Grid Grid.Column="1" Margin="10,0,0,0">
                                <Ellipse Width="220" Height="220" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{StaticResource CoAHeroGlowBrush}" Opacity="0.95"/>
                                <Border Width="220"
                                        Height="114"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        CornerRadius="18"
                                        Background="#13000000"
                                        BorderBrush="#334F78A8"
                                        BorderThickness="1"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <RotateTransform Angle="-6"/>
                                    </Border.RenderTransform>
                                </Border>
                                <Image Source="Assets/ProjectAscensionWatermark.png"
                                       Width="210"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Stretch="Uniform"
                                       Opacity="0.88"
                                       Margin="0,4,-6,0"
                                       IsHitTestVisible="False"/>
                            </Grid>
                        </Grid>
                    </RadioButton>

                    <RadioButton x:Name="TbcRadio"
                                 Grid.Column="2"
                                 GroupName="Edition"
                                 Style="{StaticResource EditionRadioStyle}"
                                 Background="#D1161317"
                                 Checked="EditionRadio_Checked">
                        <Grid ClipToBounds="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.15*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <Rectangle Grid.ColumnSpan="2"
                                       RadiusX="10"
                                       RadiusY="10"
                                       Fill="{StaticResource CardFadeBrush}"
                                       IsHitTestVisible="False"/>
                            <StackPanel VerticalAlignment="Center" Margin="0,2,0,0">
                                <Border HorizontalAlignment="Left"
                                        Background="#31452311"
                                        BorderBrush="#5A915323"
                                        BorderThickness="1"
                                        CornerRadius="999"
                                        Padding="10,4">
                                    <TextBlock Text="CLASSIC / ANNIVERSARY"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="#FBE7B8"/>
                                </Border>
                                <TextBlock Text="THE BURNING CRUSADE"
                                           Margin="0,12,0,0"
                                           FontFamily="Georgia"
                                           FontSize="18"
                                           FontWeight="Bold"/>
                                <TextBlock Text="Classic / Anniversary client"
                                           Margin="0,7,0,0"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="13"/>
                                <TextBlock Text="Separate TBC package flow with its own path detection and release channel."
                                           Margin="0,8,0,0"
                                           Foreground="#D4C7B6"
                                           FontSize="11.5"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="TBC"
                                           Margin="0,12,0,0"
                                           Foreground="#F1B34D"
                                           FontSize="11"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                            <Grid Grid.Column="1" Margin="10,0,0,0">
                                <Ellipse Width="230" Height="230" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{StaticResource TBCHeroGlowBrush}" Opacity="0.96"/>
                                <Border Width="232"
                                        Height="116"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        CornerRadius="18"
                                        Background="#14000000"
                                        BorderBrush="#3C8A6A2E"
                                        BorderThickness="1"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <RotateTransform Angle="-6"/>
                                    </Border.RenderTransform>
                                </Border>
                                <Image Source="Assets/TbcWatermark.png"
                                       Width="224"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Stretch="Uniform"
                                       Opacity="0.9"
                                       Margin="0,0,-2,0"
                                       IsHitTestVisible="False"/>
                            </Grid>
                        </Grid>
                    </RadioButton>
                </Grid>
            </Grid>

            <Border Grid.Row="4"
                    Background="#EA121A24"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    ClipToBounds="True">
                <Grid>
                    <Rectangle Height="4"
                               VerticalAlignment="Top">
                        <Rectangle.Style>
                            <Style TargetType="Rectangle">
                                <Setter Property="Fill" Value="#5588B4FF"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=TbcRadio}" Value="True">
                                        <Setter Property="Fill" Value="#55D49B45"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Rectangle.Style>
                    </Rectangle>

                    <Rectangle IsHitTestVisible="False">
                        <Rectangle.Style>
                            <Style TargetType="Rectangle">
                                <Setter Property="Fill" Value="{StaticResource CoADetailOverlayBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=TbcRadio}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource TbcDetailOverlayBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Rectangle.Style>
                    </Rectangle>

                    <Image Source="Assets/ProjectAscensionWatermark.png" Width="350">
                        <Image.Style>
                            <Style TargetType="Image" BasedOn="{StaticResource DetailWatermarkStyle}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=CoARadio}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                    <Image Source="Assets/TbcWatermark.png" Width="420">
                        <Image.Style>
                            <Style TargetType="Image" BasedOn="{StaticResource DetailWatermarkStyle}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=TbcRadio}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>

                    <Grid Margin="18,20,18,18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="EditionTitleText"
                                           Text="Conquest of Azeroth"
                                           FontFamily="Georgia"
                                           FontSize="22"
                                           FontWeight="Bold"/>
                                <TextBlock x:Name="EditionSubtitleText"
                                           Text="Project Ascension installation"
                                           Margin="0,4,0,0"
                                           Foreground="{StaticResource MutedTextBrush}"/>
                            </StackPanel>
                            <Button x:Name="LauncherUpdateButton"
                                    Grid.Column="1"
                                    Content="UPDATE LAUNCHER"
                                    Margin="14,0,0,0"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Visibility="Collapsed"
                                    Click="LauncherUpdateButton_Click"/>
                        </Grid>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource VersionCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="INSTALLED"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="11"
                                               FontWeight="SemiBold"/>
                                    <TextBlock x:Name="InstalledVersionText"
                                               Text="Unknown"
                                               Margin="0,7,0,0"
                                               FontFamily="Georgia"
                                               FontSize="23"
                                               FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource VersionCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="LATEST ON CHANNEL"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="11"
                                               FontWeight="SemiBold"/>
                                    <TextBlock x:Name="LatestVersionText"
                                               Text="Checking..."
                                               Margin="0,7,0,0"
                                               FontFamily="Georgia"
                                               FontSize="23"
                                               FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="#DE131C27"
                                    BorderBrush="{StaticResource SoftBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="14,11">
                                <StackPanel>
                                    <TextBlock x:Name="PathLabelText"
                                               Text="PROJECT ASCENSION ADDONS FOLDER"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="10.5"
                                               FontWeight="SemiBold"/>
                                    <TextBlock x:Name="PathText"
                                               Text="Not selected"
                                               Margin="0,5,0,0"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                </StackPanel>
                            </Border>
                            <Button Grid.Column="2"
                                    Content="Choose Folder"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="ChooseFolderButton_Click"/>
                        </Grid>

                        <Grid Grid.Row="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <Button x:Name="UpdateButton"
                                        Content="CHECKING..."
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        IsEnabled="False"
                                        Click="UpdateButton_Click"/>
                                <ProgressBar x:Name="DownloadProgress"
                                             Height="5"
                                             Margin="0,8,0,0"
                                             Minimum="0"
                                             Maximum="100"
                                             Foreground="{StaticResource AccentBrush}"
                                             Background="#33000000"
                                             Visibility="Collapsed"/>
                            </StackPanel>
                            <Button x:Name="RefreshButton"
                                    Grid.Column="2"
                                    Content="Refresh"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="RefreshButton_Click"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="6"
                    Background="#E8121820"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="ReleaseHeadingText"
                               Text="LATEST COA CHANGES"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource MutedTextBrush}"/>
                    <TextBox x:Name="ReleaseNotesText"
                             Grid.Row="2"
                             Text="Checking GitHub releases..."
                             IsReadOnly="True"
                             BorderThickness="0"
                             Padding="0"
                             Background="Transparent"
                             Foreground="{StaticResource TextBrush}"
                             CaretBrush="{StaticResource TextBrush}"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Segoe UI"
                             FontSize="13.5"/>
                </Grid>
            </Border>

            <Grid Grid.Row="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot"
                             Width="9"
                             Height="9"
                             Fill="{StaticResource MutedTextBrush}"
                             Margin="0,0,8,0"/>
                    <TextBlock x:Name="StatusText"
                               Text="Starting launcher..."
                               Foreground="{StaticResource MutedTextBrush}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Button x:Name="SupportButton"
                        Grid.Column="1"
                        Content="Support RetreatUI"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="SupportButton_Click"/>
                <Button x:Name="OpenFolderButton"
                        Grid.Column="3"
                        Content="Open AddOns Folder"
                        Style="{StaticResource SecondaryButtonStyle}"
                        IsEnabled="False"
                        Click="OpenFolderButton_Click"/>
                <Button x:Name="LaunchButton"
                        Grid.Column="5"
                        Content="Launch CoA"
                        Style="{StaticResource SecondaryButtonStyle}"
                        IsEnabled="False"
                        Click="LaunchButton_Click"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
