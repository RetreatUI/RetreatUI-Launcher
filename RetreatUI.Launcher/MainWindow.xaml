<Window x:Class="RetreatUI.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RetreatUI Launcher"
        Width="980"
        Height="740"
        MinWidth="880"
        MinHeight="660"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/RetreatUI_Launcher.ico">
    <Grid Background="{StaticResource BackgroundBrush}" Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="72"
                        Height="72"
                        Background="#090A0C"
                        BorderBrush="#5C4527"
                        BorderThickness="1"
                        CornerRadius="12"
                        SnapsToDevicePixels="True">
                    <Image Source="Assets/RetreatUI_Launcher_256.png"
                           Width="68"
                           Height="68"
                           Stretch="Uniform"
                           SnapsToDevicePixels="True"/>
                </Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="RETREATUI"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="ADDON LAUNCHER"
                               Margin="1,-2,0,0"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource MutedTextBrush}"/>
                    <TextBlock x:Name="LauncherVersionText"
                               Text="Launcher"
                               Margin="1,5,0,0"
                               FontSize="11.5"
                               Foreground="{StaticResource MutedTextBrush}"/>
                </StackPanel>
            </Grid>
            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                <TextBlock Text="Update Channel"
                           HorizontalAlignment="Right"
                           Foreground="{StaticResource MutedTextBrush}"
                           Margin="0,0,0,6"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <RadioButton x:Name="StableRadio"
                                 Content="Stable"
                                 GroupName="Channel"
                                 IsChecked="True"
                                 Style="{StaticResource ChannelRadioStyle}"
                                 Checked="ChannelRadio_Checked"/>
                    <RadioButton x:Name="BetaRadio"
                                 Content="Beta"
                                 GroupName="Channel"
                                 Margin="8,0,0,0"
                                 Style="{StaticResource ChannelRadioStyle}"
                                 Checked="ChannelRadio_Checked"/>
                </StackPanel>
                <Button x:Name="LauncherUpdateButton"
                        Content="Update Launcher"
                        Margin="0,10,0,0"
                        HorizontalAlignment="Right"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Visibility="Collapsed"
                        Click="LauncherUpdateButton_Click"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="18">
                <StackPanel>
                    <TextBlock Text="INSTALLED VERSION"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource MutedTextBrush}"/>
                    <TextBlock x:Name="InstalledVersionText"
                               Text="Checking..."
                               Margin="0,7,0,0"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="18">
                <StackPanel>
                    <TextBlock Text="LATEST VERSION"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource MutedTextBrush}"/>
                    <TextBlock x:Name="LatestVersionText"
                               Text="Checking..."
                               Margin="0,7,0,0"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="4"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="PROJECT ASCENSION ADDONS FOLDER"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedTextBrush}"/>
                        <TextBlock x:Name="PathText"
                                   Text="Not selected"
                                   Margin="0,5,16,0"
                                   Foreground="{StaticResource TextBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="Choose Folder"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="ChooseFolderButton_Click"/>
                </Grid>

                <ProgressBar x:Name="DownloadProgress"
                             Grid.Row="2"
                             Height="8"
                             Minimum="0"
                             Maximum="100"
                             Value="0"
                             Visibility="Collapsed"
                             Foreground="{StaticResource AccentBrush}"
                             Background="{StaticResource PanelAltBrush}"/>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="UpdateButton"
                            Grid.Column="0"
                            Content="CHECKING FOR UPDATES..."
                            Style="{StaticResource PrimaryButtonStyle}"
                            IsEnabled="False"
                            Click="UpdateButton_Click"/>
                    <Button x:Name="RefreshButton"
                            Grid.Column="2"
                            Content="Refresh"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="RefreshButton_Click"/>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="6"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="LATEST CHANGES"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource MutedTextBrush}"/>
                <TextBox x:Name="ReleaseNotesText"
                         Grid.Row="2"
                         Text="Checking GitHub releases..."
                         IsReadOnly="True"
                         BorderThickness="0"
                         Padding="0"
                         Background="Transparent"
                         Foreground="{StaticResource TextBrush}"
                         CaretBrush="{StaticResource TextBrush}"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         FontFamily="Segoe UI"
                         FontSize="13.5"/>
            </Grid>
        </Border>

        <Grid Grid.Row="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse x:Name="StatusDot"
                         Width="9"
                         Height="9"
                         Fill="{StaticResource MutedTextBrush}"
                         Margin="0,0,8,0"/>
                <TextBlock x:Name="StatusText"
                           Text="Starting launcher..."
                           Foreground="{StaticResource MutedTextBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <Button x:Name="OpenFolderButton"
                    Grid.Column="1"
                    Content="Open AddOns Folder"
                    Style="{StaticResource SecondaryButtonStyle}"
                    IsEnabled="False"
                    Click="OpenFolderButton_Click"/>
            <Button x:Name="LaunchButton"
                    Grid.Column="3"
                    Content="Launch Ascension"
                    Style="{StaticResource SecondaryButtonStyle}"
                    IsEnabled="False"
                    Click="LaunchButton_Click"/>
        </Grid>
    </Grid>
</Window>