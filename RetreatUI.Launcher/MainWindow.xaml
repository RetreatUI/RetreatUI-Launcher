<Window x:Class="RetreatUI.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RetreatUI Launcher"
        Width="1100"
        Height="850"
        MinWidth="980"
        MinHeight="760"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Icon="Assets/RetreatUI_Launcher.ico">
    <Window.Resources>
        <Style x:Key="EditionRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="#E20A141D"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="164"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="EditionCard"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                ClipToBounds="True"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <ContentPresenter HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Stretch"/>
                                <Border x:Name="SelectionRing"
                                        Width="27"
                                        Height="27"
                                        CornerRadius="14"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Margin="0,0,18,0"
                                        Background="#78050A0E"
                                        BorderBrush="#59667583"
                                        BorderThickness="2">
                                    <Ellipse x:Name="SelectionDot"
                                             Width="15"
                                             Height="15"
                                             Fill="Transparent"/>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="EditionCard" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="EditionCard" Property="BorderThickness" Value="1.5"/>
                                <Setter TargetName="SelectionRing" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}"/>
                                <Setter TargetName="SelectionRing" Property="Background" Value="#A22D190A"/>
                                <Setter TargetName="SelectionDot" Property="Fill" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="EditionCard" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#8A5C21"
                                                          BlurRadius="12"
                                                          ShadowDepth="0"
                                                          Opacity="0.36"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="EditionCard" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="EditionCard" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VersionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#D80C1721"/>
            <Setter Property="BorderBrush" Value="{StaticResource SoftBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="17,15"/>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource LauncherBackgroundBrush}"
            BorderBrush="#26323E"
            BorderThickness="1"
            ClipToBounds="True">
        <Grid>
            <Rectangle Fill="{StaticResource HeaderGlowBrush}" IsHitTestVisible="False"/>
            <Rectangle Fill="{StaticResource SubtleTextureBrush}" IsHitTestVisible="False" Opacity="0.72"/>
            <Rectangle IsHitTestVisible="False" Opacity="0.42">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00101822" Offset="0"/>
                        <GradientStop Color="#21000000" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <Grid Margin="26,24,26,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="66"
                                Height="66"
                                CornerRadius="7"
                                BorderBrush="#6B4A2A"
                                BorderThickness="1"
                                Background="#D3050B10"
                                Margin="0,0,18,0">
                            <Image Source="Assets/RetreatUI_Launcher_256.png"
                                   Width="60"
                                   Height="60"
                                   Stretch="Uniform"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="RETREATUI LAUNCHER"
                                       Foreground="{StaticResource TitleBrush}"
                                       FontFamily="Palatino Linotype"
                                       FontSize="29"
                                       FontWeight="Bold"/>
                            <TextBlock x:Name="LauncherVersionText"
                                       Text="Launcher"
                                       Margin="2,4,0,0"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="12"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                        <TextBlock Text="UPDATE CHANNEL"
                                   HorizontalAlignment="Right"
                                   Margin="0,0,0,8"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="StableRadio"
                                         GroupName="Channel"
                                         Content="Stable"
                                         Style="{StaticResource ChannelRadioStyle}"
                                         Checked="ChannelRadio_Checked"/>
                            <RadioButton x:Name="BetaRadio"
                                         GroupName="Channel"
                                         Content="Beta"
                                         Margin="9,0,0,0"
                                         Style="{StaticResource ChannelRadioStyle}"
                                         Checked="ChannelRadio_Checked"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="CHOOSE YOUR GAME"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="11"
                               FontWeight="SemiBold"/>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <RadioButton x:Name="CoARadio"
                                     GroupName="Edition"
                                     Style="{StaticResource EditionRadioStyle}"
                                     Checked="EditionRadio_Checked">
                            <Grid ClipToBounds="True">
                                <Image Source="Assets/ProjectAscensionWatermark.png"
                                       Width="310"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Stretch="Uniform"
                                       Opacity="0.68"
                                       Margin="0,0,28,0"
                                       IsHitTestVisible="False"/>
                                <Rectangle Fill="{StaticResource CardLeftFadeBrush}" IsHitTestVisible="False"/>
                                <StackPanel VerticalAlignment="Center" Margin="24,0,130,0">
                                    <TextBlock Text="CONQUEST OF AZEROTH"
                                               FontFamily="Palatino Linotype"
                                               FontSize="19"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="Project Ascension · 21 custom classes"
                                               Margin="0,7,0,0"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="13"/>
                                    <TextBlock Text="CoA"
                                               Margin="0,17,0,0"
                                               Foreground="{StaticResource AccentHoverBrush}"
                                               FontSize="12"
                                               FontWeight="SemiBold"/>
                                </StackPanel>
                            </Grid>
                        </RadioButton>

                        <RadioButton x:Name="TbcRadio"
                                     Grid.Column="2"
                                     GroupName="Edition"
                                     Style="{StaticResource EditionRadioStyle}"
                                     Checked="EditionRadio_Checked">
                            <Grid ClipToBounds="True">
                                <Image Source="Assets/TbcWatermark.png"
                                       Width="325"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Stretch="Uniform"
                                       Opacity="0.78"
                                       Margin="0,0,22,0"
                                       IsHitTestVisible="False"/>
                                <Rectangle Fill="{StaticResource CardLeftFadeBrush}" IsHitTestVisible="False"/>
                                <StackPanel VerticalAlignment="Center" Margin="24,0,145,0">
                                    <TextBlock Text="THE BURNING CRUSADE"
                                               FontFamily="Palatino Linotype"
                                               FontSize="19"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="Classic / Anniversary client"
                                               Margin="0,7,0,0"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="13"/>
                                    <TextBlock Text="TBC"
                                               Margin="0,17,0,0"
                                               Foreground="{StaticResource AccentHoverBrush}"
                                               FontSize="12"
                                               FontWeight="SemiBold"/>
                                </StackPanel>
                            </Grid>
                        </RadioButton>
                    </Grid>
                </Grid>

                <Border Grid.Row="4"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="7"
                        ClipToBounds="True">
                    <Grid>
                        <Image Source="Assets/ProjectAscensionWatermark.png"
                               Width="420"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Top"
                               Stretch="Uniform"
                               Opacity="0.16"
                               Margin="0,20,42,0"
                               IsHitTestVisible="False">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=CoARadio}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                        <Image Source="Assets/TbcWatermark.png"
                               Width="470"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Top"
                               Stretch="Uniform"
                               Opacity="0.18"
                               Margin="0,10,24,0"
                               IsHitTestVisible="False">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=TbcRadio}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                        <Rectangle Fill="{StaticResource DetailLeftFadeBrush}" IsHitTestVisible="False"/>

                        <Grid Margin="20,18,20,18">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="14"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="14"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="14"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="EditionTitleText"
                                               Text="Conquest of Azeroth"
                                               FontFamily="Palatino Linotype"
                                               FontSize="24"
                                               FontWeight="Bold"/>
                                    <TextBlock x:Name="EditionSubtitleText"
                                               Text="Project Ascension installation"
                                               Margin="0,3,0,0"
                                               Foreground="{StaticResource MutedTextBrush}"/>
                                </StackPanel>
                                <Button x:Name="LauncherUpdateButton"
                                        Grid.Column="1"
                                        Content="UPDATE LAUNCHER"
                                        Margin="14,0,0,0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Visibility="Collapsed"
                                        Click="LauncherUpdateButton_Click"/>
                            </Grid>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource VersionCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="INSTALLED"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock x:Name="InstalledVersionText"
                                                   Text="Unknown"
                                                   Margin="0,7,0,0"
                                                   FontFamily="Palatino Linotype"
                                                   FontSize="24"
                                                   FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource VersionCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="LATEST ON CHANNEL"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock x:Name="LatestVersionText"
                                                   Text="Checking..."
                                                   Margin="0,7,0,0"
                                                   FontFamily="Palatino Linotype"
                                                   FontSize="24"
                                                   FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid Grid.Row="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#DA0C1721"
                                        BorderBrush="{StaticResource SoftBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="15,11">
                                    <StackPanel>
                                        <TextBlock x:Name="PathLabelText"
                                                   Text="PROJECT ASCENSION ADDONS FOLDER"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="10.5"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock x:Name="PathText"
                                                   Text="Not selected"
                                                   Margin="0,5,0,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                    </StackPanel>
                                </Border>
                                <Button Grid.Column="2"
                                        Content="Choose Folder"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="ChooseFolderButton_Click"/>
                            </Grid>

                            <Grid Grid.Row="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <Button x:Name="UpdateButton"
                                            Content="CHECKING..."
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            IsEnabled="False"
                                            Click="UpdateButton_Click"/>
                                    <ProgressBar x:Name="DownloadProgress"
                                                 Height="5"
                                                 Margin="0,8,0,0"
                                                 Minimum="0"
                                                 Maximum="100"
                                                 Foreground="{StaticResource AccentBrush}"
                                                 Background="#33000000"
                                                 Visibility="Collapsed"/>
                                </StackPanel>
                                <Button x:Name="RefreshButton"
                                        Grid.Column="2"
                                        Content="Refresh"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="RefreshButton_Click"/>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="6"
                        Background="#E60A141D"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="7"
                        Padding="19,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="9"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="ReleaseHeadingText"
                                   Text="LATEST COA CHANGES"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedTextBrush}"/>
                        <TextBox x:Name="ReleaseNotesText"
                                 Grid.Row="2"
                                 Text="Checking GitHub releases..."
                                 IsReadOnly="True"
                                 BorderThickness="0"
                                 Padding="0"
                                 Background="Transparent"
                                 Foreground="{StaticResource TextBrush}"
                                 CaretBrush="{StaticResource TextBrush}"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 FontFamily="Segoe UI"
                                 FontSize="13.5"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="9"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="9"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot"
                                 Width="9"
                                 Height="9"
                                 Fill="{StaticResource MutedTextBrush}"
                                 Margin="0,0,8,0"/>
                        <TextBlock x:Name="StatusText"
                                   Text="Starting launcher..."
                                   Foreground="{StaticResource MutedTextBrush}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button x:Name="SupportButton"
                            Grid.Column="1"
                            Content="Support RetreatUI"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="SupportButton_Click"/>
                    <Button x:Name="OpenFolderButton"
                            Grid.Column="3"
                            Content="Open AddOns Folder"
                            Style="{StaticResource SecondaryButtonStyle}"
                            IsEnabled="False"
                            Click="OpenFolderButton_Click"/>
                    <Button x:Name="LaunchButton"
                            Grid.Column="5"
                            Content="Launch CoA"
                            Style="{StaticResource SecondaryButtonStyle}"
                            IsEnabled="False"
                            Click="LaunchButton_Click"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
