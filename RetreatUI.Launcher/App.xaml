<Application x:Class="RetreatUI.Launcher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#071018"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#E80B141D"/>
        <SolidColorBrush x:Key="PanelAltBrush" Color="#E80E1822"/>
        <SolidColorBrush x:Key="PanelDeepBrush" Color="#F3070E15"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#C98628"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#E9A544"/>
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#6A3D220F"/>
        <SolidColorBrush x:Key="TitleBrush" Color="#D6A45F"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F1EEE8"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#A0A9B5"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#72C95B"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#E47770"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#33404E"/>
        <SolidColorBrush x:Key="SoftBorderBrush" Color="#27323D"/>

        <LinearGradientBrush x:Key="LauncherBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#08131D" Offset="0"/>
            <GradientStop Color="#071019" Offset="0.48"/>
            <GradientStop Color="#090D12" Offset="1"/>
        </LinearGradientBrush>

        <RadialGradientBrush x:Key="HeaderGlowBrush"
                             Center="0.18,0.06"
                             GradientOrigin="0.18,0.06"
                             RadiusX="0.72"
                             RadiusY="0.52">
            <GradientStop Color="#1C294052" Offset="0"/>
            <GradientStop Color="#00131D29" Offset="1"/>
        </RadialGradientBrush>

        <LinearGradientBrush x:Key="CardLeftFadeBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FB0B151F" Offset="0"/>
            <GradientStop Color="#F20B151F" Offset="0.47"/>
            <GradientStop Color="#A30B151F" Offset="0.72"/>
            <GradientStop Color="#210B151F" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DetailLeftFadeBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FC0A141D" Offset="0"/>
            <GradientStop Color="#F50A141D" Offset="0.58"/>
            <GradientStop Color="#C80A141D" Offset="0.78"/>
            <GradientStop Color="#7A0A141D" Offset="1"/>
        </LinearGradientBrush>

        <DrawingBrush x:Key="SubtleTextureBrush"
                      TileMode="Tile"
                      Viewport="0,0,28,28"
                      ViewportUnits="Absolute"
                      Viewbox="0,0,28,28"
                      ViewboxUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup Opacity="0.18">
                    <GeometryDrawing Brush="Transparent">
                        <GeometryDrawing.Pen>
                            <Pen Brush="#17344A5B" Thickness="0.45"/>
                        </GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <LineGeometry StartPoint="0,27.5" EndPoint="28,27.5"/>
                                <LineGeometry StartPoint="27.5,0" EndPoint="27.5,28"/>
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#152C3C49" Geometry="M 5,5 L 6,5 6,6 5,6 Z"/>
                    <GeometryDrawing Brush="#122D3944" Geometry="M 19,12 L 20,12 20,13 19,13 Z"/>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <Style TargetType="Window">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Background" Value="{StaticResource BackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#F8F0E2"/>
            <Setter Property="Background" Value="#8F5A2B12"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,11"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#B2703619"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.46"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="#C60C151E"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="MinHeight" Value="39"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#DD14212D"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChannelRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="Background" Value="#9A0B141C"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="MinWidth" Value="74"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="RadioBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="RadioBorder" Property="Background" Value="#A634210F"/>
                                <Setter TargetName="RadioBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="#F8E4C5"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RadioBorder" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="RadioBorder" Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
